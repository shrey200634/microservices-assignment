# --- MySQL root credentials (used by both services' schemas) ---
MYSQL_ROOT_PASSWORD=root
DB_USERNAME=root
DB_PASSWORD=root

# --- JWT — MUST be identical in user-service and api-gateway ---
JWT_SECRET=replace-with-a-long-random-base64-secret-at-least-32-bytes

# --- Email (Gmail SMTP, used by notification-service) ---
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password